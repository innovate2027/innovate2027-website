# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_SUBMISSIONS_BUCKET=event-submissions

# Razorpay SJIIF merchant account keys (use TEST keys first; switch to LIVE only after approval)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Fixed registration fee: ₹300 per team per event = 30000 paise
REGISTRATION_FEE_PAISE=30000
CURRENCY=INR

# Protect /admin and admin API. Use a long random secret.
ADMIN_ACCESS_KEY=REPLACE_WITH_LONG_RANDOM_SECRET

# Optional transactional email via Resend. Verified institutional sender required.
RESEND_API_KEY=
EMAIL_FROM=INNOVATE 2027 <registrations@your-approved-domain.in>
